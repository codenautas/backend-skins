}*/

.dialog-promise .dialog-promise-close-button:hover {
    background-color: #aaa;
}


/* proc input */
.table-param-screen td[contenteditable="true"] {
  border: 2px solid #ddd;
  border-radius: 5px;
  box-shadow: 0 0 5px #ddd;
}

/* proc result */

.result-div {
  padding: 8px 12px;
  border-radius: 4px;
  font-weight: 500;
  width: fit-content;
  min-height: none;
}

.result-div[result=success] {
  background-color: #DCFCE7 !important;
  color: #166534;
  border-left: 4px solid #22C55E;
}

.result-div[result=error] {
  background-color: #FEF3C7 !important;
  color: #92400E;
  border-left: 4px solid #F59E0B;
}

// Estilo para todos los inputs del sistema
input
  border 1px solid #ddd
  padding 3px 5px
  position relative
  background transparent
  border-radius 4px // Un pequeño radio para que no sea tan rígido
  font-size 14px
  transition border-color 0.2s ease, box-shadow 0.2s ease
  outline none // Quitamos el outline azul por defecto del navegador

input:focus
  border-color var(--primary)
  box-shadow 0 0 0 1px var(--primary)